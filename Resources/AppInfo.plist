<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>yaz</string>
    <key>CFBundleIdentifier</key>
    <string>com.mikeowski.yaz</string>
    <key>CFBundleName</key>
    <string>yaz</string>
    <key>CFBundleDisplayName</key>
    <string>yaz</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.2.0</string>
    <!-- Sparkle compares this, not the version string: raise it by one for
         every release. -->
    <key>CFBundleVersion</key>
    <string>2</string>
    <key>LSMinimumSystemVersion</key>
    <string>26.0</string>

    <!-- Lives in the menu bar; no dock icon and no window. -->
    <key>LSUIElement</key>
    <true/>

    <!-- What the user reads in the permission prompt. As a .app, yaz has its
         own TCC identity: the prompt says "yaz", and the grant attaches to yaz
         rather than to the terminal that launched it. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>yaz listens to the microphone while you hold the push-to-talk key and turns your speech into text. The audio never leaves this Mac.</string>

    <!-- Sparkle: where updates are announced, and the EdDSA key they are
         signed with. The private key is in the maintainer's login Keychain
         (Sparkle's generate_keys); scripts/release.sh checks that it matches
         this public key before it signs the feed. -->
    <key>SUFeedURL</key>
    <string>https://yaz.mike4.dev/downloads/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>RbsagAYTubqg7KNIVzGtAVuNBoo4eL+wLLLCLDOc4Ps=</string>
    <key>SUEnableAutomaticChecks</key>
    <true/>

    <key>NSHumanReadableCopyright</key>
    <string>MIT</string>
</dict>
</plist>
